# vadsa settings. Copy this file to .env and set VADSA_API_KEYS.
# Every commented line shows the default; the README's "Configuration" table says what each does.

# Required: comma-separated bearer keys for /v1/*. Production refuses to start without one.
VADSA_API_KEYS=

# VADSA_ENVIRONMENT=production
# VADSA_ENGINE=nemo
# VADSA_MODEL=KlangAI/pianissimo-sv
# VADSA_SERVED_MODEL_NAME=KlangAI/pianissimo-sv
# VADSA_MAX_UPLOAD_BYTES=1073741824
# VADSA_MAX_AUDIO_SECONDS=18000
# VADSA_WINDOW_SECONDS=600
# VADSA_MAX_BATCH_REQUESTS=4
# VADSA_MAX_SESSIONS=32
# VADSA_MAX_SESSION_SECONDS=18000
# VADSA_MAX_SESSION_WALL_SECONDS=39600
# VADSA_FINALIZE_SECONDS=45
# VADSA_IDLE_TIMEOUT_SECONDS=300
# VADSA_MAX_PENDING_SECONDS=30
# VADSA_STREAM_CHUNK_SECONDS=1.0
# VADSA_STREAM_LEFT_PADDING_SECONDS=6.0
# VADSA_STREAM_RIGHT_PADDING_SECONDS=1.0

# Optional Hugging Face token. The model is public; a token only raises download rate limits.
# HF_TOKEN=

# Read by the compose files only.
# VADSA_VERSION=latest
# VADSA_BIND=127.0.0.1
# VADSA_PORT=8000
# VADSA_SHARED_NETWORK=eneo-shared
